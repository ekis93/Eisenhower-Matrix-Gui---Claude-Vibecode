<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EisenhowerMatrix.MainWindow"
        Title="Eisenhower Matrix"
        Width="900"
        Height="600"
        MinWidth="600"
        MinHeight="400"
        RequestedThemeVariant="Light">
    <!-- Row 0 = input area, Row 1 = the matrix -->
    <Grid RowDefinitions="Auto,*"
          Margin="10">
        <!-- Input area -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,10">
            <TextBlock Text="Task:"
                       VerticalAlignment="Center" />
            <TextBox x:Name="TaskInput"
                     Width="350" />
            <CheckBox x:Name="ImportantBox"
                      Content="Important" />
            <CheckBox x:Name="UrgentBox"
                      Content="Urgent" />
            <Button Content="Add"
                    IsDefault="True"
                    Click="AddButton_Click" />
        </StackPanel>
        <!-- The 2x2 matrix -->
        <Grid Grid.Row="1"
              RowDefinitions="*,*"
              ColumnDefinitions="*,*">
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Background="LightGreen"
                    Margin="4"
                    Padding="8"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="DO (Important + Urgent)"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <ListBox x:Name="DoList"
                             DoubleTapped="List_DoubleTapped" />
                </DockPanel>
            </Border>
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Background="LightBlue"
                    Margin="4"
                    Padding="8"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="PLAN (Important + Not urgent)"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <ListBox x:Name="PlanList"
                             DoubleTapped="List_DoubleTapped" />
                </DockPanel>
            </Border>
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="Khaki"
                    Margin="4"
                    Padding="8"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="DELEGATE (Not important + Urgent)"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <ListBox x:Name="DelegateList"
                             DoubleTapped="List_DoubleTapped" />
                </DockPanel>
            </Border>
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Background="LightPink"
                    Margin="4"
                    Padding="8"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="DELETE (Not important + Not urgent)"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <ListBox x:Name="DeleteList"
                             DoubleTapped="List_DoubleTapped" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>